---
layout: base.njk
title: Contact — Get a Free Painting Quote in Cairns
description: Get a free, on-site painting quote in Cairns. Adrian usually picks up before lunch. Call 0478 659 766 or fill in the form.
permalink: /contact-us/
canonical: /contact-us/
---

<style>
.page-hero{ padding: clamp(48px,7vw,80px) 0 clamp(28px,3vw,48px); position:relative; overflow:hidden }
.page-hero::before{ content:""; position:absolute; right:-160px; top:-100px; width:480px; height:480px; border-radius:50%; background:var(--yellow); opacity:.5; z-index:0 }
.page-hero .wrap{ position:relative; z-index:1 }
.page-hero h1{ font-size: clamp(48px, 6vw, 96px); }

.contact-grid{ display:grid; grid-template-columns: 1.2fr 1fr; gap: clamp(28px,4vw,72px); align-items:start }
.contact-card{
  background: var(--ink); color:#fff;
  border-radius: var(--radius-l);
  padding: 32px;
  display:flex; flex-direction:column; gap: 28px;
}
.contact-card h3{ color:#fff }
.contact-card .row{
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,.12);
  display:flex; flex-direction:column; gap:6px;
}
.contact-card .row:last-of-type{ border-bottom:0 }
.contact-card .lbl{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color: rgba(255,255,255,.55) }
.contact-card a, .contact-card span.val{
  color:#fff; font-family:var(--display); font-weight:500; font-size: clamp(18px,1.8vw,22px); letter-spacing:-.01em;
}
.contact-card a:hover{ color:var(--yellow) }
@media (max-width: 980px){ .contact-grid{ grid-template-columns: 1fr } }

.map-row{ background: var(--bg-soft) }
.map-row .grid{ display:grid; grid-template-columns: 1fr 1fr; gap: clamp(28px,4vw,64px); align-items:center }
.map-embed{
  aspect-ratio: 4/3; border-radius: var(--radius-l); overflow:hidden;
  border:1px solid var(--rule);
}
.map-embed iframe{ width:100%; height:100%; border:0; display:block }
@media (max-width: 860px){ .map-row .grid{ grid-template-columns: 1fr } }

/* WhatsApp conversion block — the mobile focus; hidden on desktop where the form leads */
.wa-cta-mobile{ display:none; padding-top: clamp(20px,3vw,28px) }
.wa-cta-btn{
  display:flex; align-items:center; gap:14px;
  background:#25D366; color:#fff;
  border-radius: var(--radius-l);
  padding: 18px 20px;
  box-shadow: 0 6px 18px rgba(37,211,102,.35);
}
.wa-cta-btn img{ flex:0 0 auto; border-radius:8px }
.wa-cta-btn span{ display:flex; flex-direction:column; gap:2px; flex:1 }
.wa-cta-btn strong{ font-size:17px; font-weight:700 }
.wa-cta-btn small{ font-size:13px; opacity:.92; line-height:1.4 }
.wa-cta-btn .arr{ font-size:22px; flex:0 0 auto }
.wa-cta-btn:active{ transform: scale(.99) }
@media (max-width: 768px){ .wa-cta-mobile{ display:block } }
</style>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Get a free quote</span>
    <h1 style="margin-top:14px">Tell us about the job.<br/>We'll be in touch today.</h1>
    <p class="lede" style="margin-top:22px;max-width:62ch">
      For the quickest response, please call me ({{ site.owner }}) directly on {{ site.phone_display }}. I am always more than happy to provide information over the phone, or come and provide you with a quote — free, on-site and obligation-free.
    </p>
  </div>
</section>

<section class="wa-cta-mobile">
  <div class="wrap">
    <a class="wa-cta-btn" href="https://wa.me/61478659766?text=Hi%20Adrian%2C%20I%27m%20after%20a%20painting%20quote%20%E2%80%94%20" target="_blank" rel="noopener">
      <img src="/assets/images/whatsapp-icon.png?v={{ buildId }}" alt="" width="34" height="34" />
      <span>
        <strong>Message Adrian on WhatsApp</strong>
        <small>Fastest way to get a quote — send a photo of the job and he'll come straight back to you.</small>
      </span>
      <span class="arr">→</span>
    </a>
  </div>
</section>

<section style="padding-top: clamp(28px,3vw,40px)">
  <div class="wrap">
    <div class="contact-grid">
      <form class="qform" action="/api/contact" method="POST">
        <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />

        <div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div><label>Your name</label><input class="field" name="name" required placeholder="Sarah K." /></div>
          <div><label>Phone</label><input class="field" name="phone" required placeholder="04…" /></div>
        </div>
        <div><label>Email</label><input class="field" type="email" name="email" placeholder="sarah@example.com" /></div>
        <div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div><label>Suburb</label><input class="field" name="suburb" placeholder="Trinity Beach" /></div>
          <div><label>Postcode</label><input class="field" name="pcode" placeholder="4879" /></div>
        </div>
        <div><label>Type of job</label>
          <select class="field" name="job">
            <option>Interior repaint</option>
            <option>Exterior repaint</option>
            <option>Roof painting</option>
            <option>Commercial / strata</option>
            <option>Industrial / epoxy</option>
            <option>Mould or graffiti removal</option>
            <option>Pressure cleaning</option>
            <option>Just a quote — not sure yet</option>
          </select>
        </div>
        <div><label>Timeframe</label>
          <select class="field" name="when">
            <option>ASAP / within 2 weeks</option>
            <option>Within a month</option>
            <option>Within 3 months</option>
            <option>Planning ahead, no rush</option>
          </select>
        </div>
        <div><label>Tell us a bit about the job</label><textarea class="field" name="msg" placeholder="3-bed Queenslander, exterior + trim, fascia is flaking, no roof. Looking to start before December."></textarea></div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;gap:14px;flex-wrap:wrap">
          <small style="color:var(--muted);font-size:12px;max-width:32ch">By submitting you agree to be contacted. We don't sell your details.</small>
          <button type="submit" class="btn btn--yellow">Request a quote <span class="arr">→</span></button>
        </div>
      </form>

      <aside class="contact-card">
        <h3>Or just ring us.</h3>
        <div>
          <div class="row">
            <span class="lbl">Phone</span>
            <a href="{{ site.phone_link }}">📞 {{ site.phone_display }}</a>
          </div>
          <div class="row">
            <span class="lbl">Email</span>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </div>
          <div class="row">
            <span class="lbl">Yard</span>
            <span class="val">{{ site.address.street }}, {{ site.address.suburb }} {{ site.address.state }} {{ site.address.postcode }}</span>
          </div>
          <div class="row">
            <span class="lbl">Hours</span>
            <span class="val">Mon–Sat · 7am–5pm</span>
            <span style="color:rgba(255,255,255,.55);font-family:var(--mono);font-size:11px;letter-spacing:.1em">Closed Sundays &amp; public holidays</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="map-row">
  <div class="wrap">
    <div class="grid">
      <div>
        <span class="eyebrow">Where we are</span>
        <h2 style="margin-top:14px">{{ site.address.suburb }}, Cairns.</h2>
        <p class="lede" style="margin-top:22px">
          Our yard is in {{ site.address.suburb }}. Most of our work is between Edmonton and Palm Cove, with occasional jobs out to Port Douglas. If you're inside that loop we'll usually be there the same week.
        </p>
        <div style="margin-top:24px;display:flex;flex-wrap:wrap;gap:6px">
          <a class="pill-chip pill-chip--yellow" href="/painter-cairns/">Cairns →</a>
          <a class="pill-chip" href="/painter-trinity-beach/">Trinity Beach</a>
          <a class="pill-chip" href="/areas/palm-cove/">Palm Cove</a>
          <a class="pill-chip pill-chip--yellow" href="/areas/holloways-beach/">Holloways · HQ</a>
          <a class="pill-chip" href="/areas/edge-hill/">Edge Hill</a>
          <a class="pill-chip" href="/areas/edmonton/">Edmonton</a>
          <a class="pill-chip" href="/areas/port-douglas/">Port Douglas</a>
        </div>
      </div>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps?q=Holloways+Beach+QLD+4878&z=12&output=embed"
          title="Map of Holloways Beach, Cairns — MrPaint HQ"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>
