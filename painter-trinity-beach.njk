{# ─── RECENT JOBS IN TRINITY BEACH ─── #}
{% if trinity_beach_recent_jobs and trinity_beach_recent_jobs.length > 0 %}
<section class="copy-block" id="trinity-beach-recent">
  <div class="wrap-narrow">
    <h2 class="sec-head">Recent jobs in Trinity Beach</h2>
    <p style="color:var(--ink-2);font-size:14px;margin-top:-6px">Real jobs from the team in Trinity Beach. Tap a card to read more.</p>

    {%- set pack_total = (trinity_beach_recent_jobs | batch(5)) | length -%}
    <div class="cairns-jobs-slider" data-pack-total="{{ pack_total }}">
    <div class="cairns-jobs-strip">
      {% for pack in trinity_beach_recent_jobs | batch(5) %}
      <div class="cairns-jobs-pack" aria-label="Recent Trinity Beach jobs page {{ loop.index }} of {{ loop.length }}">
        {% for j in pack %}
          {%- set primary_media = (j.media and j.media.length > 0) and j.media[0] or null -%}
          {%- set primary_type = primary_media and primary_media.type or (j.video and "video" or "image") -%}
          {%- set primary_src = primary_media and primary_media.src or (j.video or j.image) -%}
          {%- set body_preview = (j.body or "") | truncate(140) -%}
          <details class="job-card">
            <summary class="job-card-summary">
              <div class="job-thumb">
                {% if primary_type == "video" and primary_src %}
                  <video src="{{ primary_src }}" muted playsinline preload="metadata" aria-label="{{ j.photo_alt or j.title }}"></video>
                {% elif primary_src %}
                  <img src="{{ primary_src }}" alt="{{ j.photo_alt or j.title }}" loading="lazy" />
                {% else %}
                  <div class="job-thumb-placeholder">📷</div>
                {% endif %}
              </div>
              <div class="job-meta">
                <span class="eyebrow">{{ j.date }}</span>
                <h3>{{ j.title }}</h3>
                <p>{{ body_preview }}</p>
                <span class="job-expand-hint" aria-hidden="true">Tap to read more →</span>
              </div>
            </summary>
            <div class="job-body">
              <div class="job-body-text">{{ j.body }}</div>
              {% if j.media and j.media.length > 0 %}
              <div class="job-gallery" aria-label="Job gallery">
                {% for m in j.media %}
                  {% if m.type == "video" %}
                    <video src="{{ m.src }}" controls muted playsinline preload="metadata"></video>
                  {% else %}
                    <img src="{{ m.src }}" alt="{{ m.alt or j.photo_alt or j.title }}" loading="lazy" />
                  {% endif %}
                {% endfor %}
              </div>
              {% elif j.video %}
              <div class="job-gallery"><video src="{{ j.video }}" controls muted playsinline preload="metadata"></video></div>
              {% elif j.image %}
              <div class="job-gallery"><img src="{{ j.image }}" alt="{{ j.photo_alt or j.title }}" loading="lazy" /></div>
              {% endif %}
            </div>
          </details>
        {% endfor %}
      </div>
      {% endfor %}
    </div>

    {% if pack_total > 1 %}
    <div class="cairns-jobs-controls" role="group" aria-label="Recent jobs navigation">
      <button type="button" class="cairns-jobs-nav cairns-jobs-prev" aria-label="Previous page of jobs" disabled>←</button>
      <span class="cairns-jobs-counter"><span data-current>1</span> / {{ pack_total }}</span>
      <button type="button" class="cairns-jobs-nav cairns-jobs-next" aria-label="Next page of jobs">→</button>
    </div>
    {% endif %}
    </div>{# /.cairns-jobs-slider #}
  </div>
</section>

<style>
  .cairns-jobs-strip { display:grid; grid-auto-flow:column; grid-auto-columns:100%; overflow-x:auto; scroll-snap-type:x mandatory; gap:24px; margin-top:24px; padding-bottom:12px; scrollbar-width:thin; }
  .cairns-jobs-pack { scroll-snap-align:start; display:flex; flex-direction:column; gap:14px; }
  .job-card { border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden; transition:box-shadow .15s ease; }
  .job-card[open] { box-shadow:0 2px 12px rgba(0,0,0,.06); }
  .job-card-summary { display:grid; grid-template-columns:140px 1fr; gap:16px; padding:14px; cursor:pointer; list-style:none; align-items:center; }
  .job-card-summary::-webkit-details-marker { display:none; }
  .job-card-summary::marker { display:none; content:""; }
  .job-thumb { width:140px; aspect-ratio:4/3; background:var(--bg-soft); border-radius:8px; overflow:hidden; position:relative; }
  .job-thumb img, .job-thumb video { width:100%; height:100%; object-fit:cover; display:block; }
  .job-thumb-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:32px; opacity:.4; }
  .job-meta .eyebrow { font-size:12px; color:var(--ink-2); letter-spacing:.04em; }
  .job-meta h3 { margin:4px 0 6px; font-size:17px; line-height:1.3; }
  .job-meta p { font-size:14px; color:var(--ink-2); margin:0; line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .job-expand-hint { display:inline-block; margin-top:8px; font-size:12px; color:var(--yellow-dark,#a07700); font-weight:600; }
  .job-card[open] .job-expand-hint { display:none; }
  .job-body { padding:6px 14px 18px 14px; border-top:1px solid var(--rule); }
  .job-body-text { white-space:pre-line; color:var(--ink); line-height:1.55; margin-top:14px; }
  .job-gallery { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; margin-top:16px; }
  .job-gallery img, .job-gallery video { width:100%; border-radius:8px; aspect-ratio:4/3; object-fit:cover; display:block; }
  @media (max-width:640px) {
    .job-card-summary { grid-template-columns:100px 1fr; gap:12px; padding:10px; }
    .job-thumb { width:100px; }
    .job-meta h3 { font-size:15px; }
    .job-meta p { -webkit-line-clamp:2; font-size:13px; }
  }
  .cairns-jobs-controls { display:flex; align-items:center; justify-content:center; gap:16px; margin-top:18px; }
  .cairns-jobs-nav { width:40px; height:40px; border-radius:999px; border:1px solid var(--rule); background:#fff; color:var(--ink); font-size:18px; line-height:1; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition:background .15s ease, transform .15s ease; }
  .cairns-jobs-nav:hover:not(:disabled) { background:var(--bg-soft); transform:translateY(-1px); }
  .cairns-jobs-nav:disabled { opacity:0.35; cursor:not-allowed; }
  .cairns-jobs-counter { font-size:13px; color:var(--ink-2); font-variant-numeric:tabular-nums; }
</style>
<script>
  (function() {
    document.querySelectorAll('.cairns-jobs-slider').forEach(function (slider) {
      var strip = slider.querySelector('.cairns-jobs-strip');
      var prev = slider.querySelector('.cairns-jobs-prev');
      var next = slider.querySelector('.cairns-jobs-next');
      var counter = slider.querySelector('[data-current]');
      var total = parseInt(slider.getAttribute('data-pack-total'), 10) || 1;
      if (!strip || !prev || !next) return;
      function pageWidth() {
        var pack = strip.querySelector('.cairns-jobs-pack');
        return pack ? pack.getBoundingClientRect().width + 24 : strip.clientWidth;
      }
      function updateState() {
        var idx = Math.round(strip.scrollLeft / pageWidth());
        if (idx < 0) idx = 0;
        if (idx > total - 1) idx = total - 1;
        prev.disabled = idx <= 0;
        next.disabled = idx >= total - 1;
        if (counter) counter.textContent = String(idx + 1);
      }
      prev.addEventListener('click', function () { strip.scrollBy({ left: -pageWidth(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { strip.scrollBy({ left: pageWidth(), behavior: 'smooth' }); });
      strip.addEventListener('scroll', updateState, { passive: true });
      window.addEventListener('resize', updateState);
      updateState();
    });
  })();
</script>
{% endif %}

