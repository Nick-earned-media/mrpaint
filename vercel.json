{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/cron-gsc-ingest", "schedule": "0 4 * * 5" },
    { "path": "/api/cron-weekly", "schedule": "45 6 * * 5" },
    { "path": "/api/cron-weekly-synthesis", "schedule": "0 7 * * 6" },
    { "path": "/api/cron-keyword-sync", "schedule": "0 20 * * *" },
    { "path": "/api/cron-capture-reminders", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/reports/:scope/:date", "destination": "/api/reports/:scope/:date" },
    { "source": "/preview", "destination": "/api/preview" },
    { "source": "/chat", "destination": "/api/chat-web" }
  ],
  "redirects": [
    { "source": "/areas/trinity-beach", "destination": "/painter-trinity-beach/", "permanent": true },
    { "source": "/areas/cairns-cbd", "destination": "/painter-cairns/", "permanent": true },
    { "source": "/about", "destination": "/about-us", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/category/:path*", "destination": "/blog", "permanent": true },
    { "source": "/tag/:path*", "destination": "/blog", "permanent": true },
    { "source": "/blog/category/:path*", "destination": "/blog", "permanent": true },
    { "source": "/blog/tag/:path*", "destination": "/blog", "permanent": true },
    { "source": "/blog/page/:n", "destination": "/blog", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
