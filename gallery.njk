---
layout: base.njk
title: Gallery — Recent Painting Work in Cairns
description: MrPaint's painting portfolio — residential, commercial and industrial work from Cairns and surrounds.
permalink: /gallery/
canonical: /gallery/
---

<style>
.page-hero{ padding: clamp(48px,7vw,80px) 0 clamp(24px,3vw,40px) }
.page-hero h1{ font-size: clamp(48px, 6vw, 92px); }

.filters{ display:flex; flex-wrap:wrap; gap:8px; margin-top: 28px }
.filter{
  display:inline-flex; padding:9px 16px; border-radius: 999px;
  background:#fff; border:1px solid var(--rule);
  font-family: var(--sans); font-weight: 500; font-size:14px;
  color: var(--ink-2); cursor:pointer;
  transition: all .15s ease;
}
.filter:hover{ border-color: var(--ink) }
.filter.active{ background:var(--ink); color:#fff; border-color:var(--ink) }
.filter .ct{ margin-left:8px; font-family:var(--mono); font-size:10.5px; padding:1px 6px; border-radius:999px; background:var(--bg-soft); color:var(--ink-2) }
.filter.active .ct{ background:rgba(255,255,255,.15); color:#fff }

.work-grid{
  margin-top: 28px;
  display:grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
}
.work{
  position:relative; background:#fff; border:1px solid var(--rule);
  border-radius: var(--radius); overflow:hidden;
  display:flex; flex-direction: column;
  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}
.work:hover{ transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--ink) }
.work .ph{ aspect-ratio: 1/1; overflow:hidden; background: var(--bg-soft) }
.work .ph img{ width:100%; height:100%; object-fit:cover; transition: transform .4s ease }
.work:hover .ph img{ transform: scale(1.03) }
.work .body{ padding: 18px 20px; display:flex; flex-direction:column; gap:6px }
.work .meta-row{ display:flex; justify-content:space-between; align-items:center; gap:8px }
.work .ct{ font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color: var(--ink-2); padding:3px 9px; border-radius:999px; background: var(--yellow) }
.work .ct[data-c="commercial"]{ background:var(--ink); color:var(--yellow) }
.work .ct[data-c="industrial"]{ background:var(--ink); color:#fff }
.work .ct[data-c="roof"]{ background: var(--bg-soft); color: var(--ink-2); border:1px solid var(--rule) }
.work .loc{ font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color: var(--muted) }
.work h4{ font-size: 19px; margin-top: 4px }
.work .note{ color: var(--ink-2); font-size: 13.5px }
@media (max-width: 1000px){ .work-grid{ grid-template-columns: 1fr 1fr } }
@media (max-width: 600px){ .work-grid{ grid-template-columns: 1fr } }

.cta-strip{ background: var(--yellow); padding: clamp(40px, 5vw, 64px) 0 }
.cta-strip .wrap{ display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap: wrap }
.cta-strip h3{ font-size: clamp(28px, 3vw, 40px); max-width:30ch }
</style>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Portfolio · Cairns &amp; FNQ</span>
    <h1 style="margin-top:14px">Before. After.<br/>Honestly.</h1>
    <p class="lede" style="margin-top:22px;max-width:62ch">
      A growing collection of work from Cairns and the wider region. Every photo here is one of ours — no stock, no AI, no other painter's work passed off as ours.
    </p>

    <div class="filters" role="tablist">
      <button class="filter active" data-filter="all">All <span class="ct">{{ gallery | length }}</span></button>
      <button class="filter" data-filter="residential">Residential <span class="ct">{{ gallery | countBy("category", "residential") }}</span></button>
      <button class="filter" data-filter="commercial">Commercial <span class="ct">{{ gallery | countBy("category", "commercial") }}</span></button>
      <button class="filter" data-filter="industrial">Industrial <span class="ct">{{ gallery | countBy("category", "industrial") }}</span></button>
      <button class="filter" data-filter="roof">Roof <span class="ct">{{ gallery | countBy("category", "roof") }}</span></button>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap">
    <div class="work-grid" id="grid">
      {% for item in gallery %}
      <article class="work" data-cat="{{ item.category }}">
        <div class="ph"><img src="{{ item.image }}" alt="{{ item.alt }}"/></div>
        <div class="body">
          <div class="meta-row">
            <span class="ct" data-c="{{ item.category }}">{{ item.category | capitalize }}</span>
            <span class="loc">{{ item.location }} · {{ item.postcode }}</span>
          </div>
          <h4>{{ item.title }}</h4>
          {% if item.note %}<p class="note">{{ item.note }}</p>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-strip">
  <div class="wrap">
    <h3>Got a job you'd like to add to this gallery?</h3>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn" href="/contact-us/">Get a free quote <span class="arr">→</span></a>
      <a class="btn btn--ghost" href="{{ site.phone_link }}">📞 {{ site.phone_display }}</a>
    </div>
  </div>
</section>

<script>
document.querySelectorAll('.filter').forEach(btn => {
  btn.addEventListener('click', () => {
    const cat = btn.dataset.filter;
    document.querySelectorAll('.filter').forEach(b => b.classList.toggle('active', b === btn));
    document.querySelectorAll('.work').forEach(w => {
      w.style.display = (cat === 'all' || w.dataset.cat === cat) ? '' : 'none';
    });
  });
});
</script>
