<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline_long }}" />
  {% if canonical %}<link rel="canonical" href="{{ site.url }}{{ canonical }}" />{% endif %}

  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/assets/css/style.css" />

  {% if site.ga4_id %}
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.ga4_id }}');
  </script>
  {% endif %}

  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}" />
  <meta property="og:description" content="{{ description or site.tagline_long }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "PaintingService",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.suburb }}",
      "addressRegion": "{{ site.address.state }}",
      "postalCode": "{{ site.address.postcode }}",
      "addressCountry": "{{ site.address.country }}"
    },
    "areaServed": "{{ site.service_area }}",
    "openingHours": "Mo-Sa 07:00-17:00"
  }
  </script>
</head>
<body data-page="{{ page.fileSlug or 'home' }}">

<a class="skip" href="#main">Skip to content</a>

{# Top bar: location · hours · email · phone #}
<div class="topbar">
  <div class="wrap row">
    <div class="left">
      <span><span class="yel">●</span> Cairns &amp; Surrounding Northern Beaches</span>
      <span class="hide-md">Mon–Sat · 7am–5pm</span>
    </div>
    <div class="right">
      <a href="mailto:{{ site.email }}" class="hide-sm">{{ site.email }}</a>
      <a href="{{ site.phone_link }}">📞 {{ site.phone_display }}</a>
    </div>
  </div>
</div>

{# Sticky header: logo, nav, phone + CTA #}
<header class="site-hd">
  <div class="wrap row">
    <a class="brand" href="/" aria-label="MrPaint home">
      <img src="/assets/images/mrpaint-logo.png" alt="MrPaint" />
    </a>
    <nav class="main" aria-label="Main">
      <a href="/about-us/"{% if page.url == "/about-us/" %} class="current"{% endif %}>About</a>
      <a href="/services/"{% if page.url == "/services/" %} class="current"{% endif %}>Services</a>
      <a href="/commercial-painter-cairns/"{% if page.url == "/commercial-painter-cairns/" %} class="current"{% endif %}>Commercial</a>
      <a href="/industrial-painting/"{% if page.url == "/industrial-painting/" %} class="current"{% endif %}>Industrial</a>
      <a href="/gallery/"{% if page.url == "/gallery/" %} class="current"{% endif %}>Gallery</a>
    </nav>
    <div class="hd-cta">
      <a class="wa-btn" href="https://wa.me/61478659766?text=Hi%20Adrian%2C%20I%27m%20after%20a%20painting%20quote%20%E2%80%94%20" target="_blank" rel="noopener" aria-label="Message MrPaint on WhatsApp">
        <img src="/assets/images/whatsapp-icon.png" alt="" width="24" height="24" />
        <span class="wa-text">WhatsApp</span>
      </a>
      <a class="phone" href="{{ site.phone_link }}" aria-label="Call MrPaint">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.9.36 1.79.7 2.63a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.45-1.27a2 2 0 0 1 2.11-.45c.84.34 1.73.57 2.63.7A2 2 0 0 1 22 16.92Z"/></svg>
        <span class="phone-text">{{ site.phone_display }}</span>
      </a>
      <a class="btn btn--yellow" href="/contact-us/">Get a free quote <span class="arr">→</span></a>
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden>
    <a href="/"{% if page.url == "/" %} class="current"{% endif %}>Home</a>
    <a href="/about-us/"{% if page.url == "/about-us/" %} class="current"{% endif %}>About</a>
    <a href="/services/"{% if page.url == "/services/" %} class="current"{% endif %}>Services</a>
    <a href="/commercial-painter-cairns/"{% if page.url == "/commercial-painter-cairns/" %} class="current"{% endif %}>Commercial</a>
    <a href="/industrial-painting/"{% if page.url == "/industrial-painting/" %} class="current"{% endif %}>Industrial</a>
    <a href="/gallery/"{% if page.url == "/gallery/" %} class="current"{% endif %}>Gallery</a>
    <a href="/blog/"{% if page.url == "/blog/" %} class="current"{% endif %}>Blog</a>
    <a href="/contact-us/" class="mobile-nav-cta">Get a free quote →</a>
  </nav>
</header>
<script>
(function () {
  var btn = document.querySelector(".nav-toggle");
  var nav = document.getElementById("mobile-nav");
  if (!btn || !nav) return;
  btn.addEventListener("click", function () {
    var open = nav.hasAttribute("hidden");
    if (open) { nav.removeAttribute("hidden"); } else { nav.setAttribute("hidden", ""); }
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    btn.classList.toggle("is-open", open);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && !nav.hasAttribute("hidden")) btn.click();
  });
})();
</script>

<main id="main">
  {{ content | safe }}
</main>

<footer class="site-ft">
  <div class="wrap">
    <div class="ft-grid">
      <div>
        <div class="ft-brand">
          <img src="/assets/images/mrpaint-logo.png" alt="MrPaint" />
        </div>
        <p class="small" style="color:rgba(255,255,255,.7);max-width:36ch">A local, family-run painting company in Cairns. Trade-qualified. Fully insured. Free quotes.</p>
      </div>
      <div>
        <h5>Services</h5>
        <ul>
          <li><a href="/services/">All services</a></li>
          <li><a href="/painter-cairns/">Painter Cairns</a></li>
          <li><a href="/commercial-painter-cairns/">Commercial</a></li>
          <li><a href="/industrial-painting/">Industrial</a></li>
          <li><a href="/roof-painter-cairns/">Roof Painter</a></li>
          <li><a href="/gallery/">Gallery</a></li>
        </ul>
      </div>
      <div>
        <h5>Company</h5>
        <ul>
          <li><a href="/about-us/">About us</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact-us/">Get a quote</a></li>
        </ul>
      </div>
      <div>
        <h5>Contact</h5>
        <ul>
          <li><a href="{{ site.phone_link }}">{{ site.phone_display }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{{ site.address.street }},<br/>{{ site.address.suburb }} {{ site.address.state }} {{ site.address.postcode }}</li>
          <li>Mon–Sat · 7am–5pm</li>
        </ul>
      </div>
    </div>
    <div class="ft-bottom">
      <span>© {{ currentYear }} {{ site.name }} Pty Ltd · Made in Cairns.</span>
      <span>{{ site.service_area }}</span>
    </div>
  </div>
</footer>

{% if site.ga4_id %}
<script>
/* GA4 conversion events: tap-to-call, email clicks, form activity, lead. */
(function () {
  function send(name, params) {
    if (typeof gtag === "function") gtag("event", name, params || {});
  }
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest("a[href]");
    if (!a) return;
    var href = a.getAttribute("href") || "";
    if (href.indexOf("tel:") === 0) {
      send("tap_to_call", { link_text: (a.textContent || "").trim().slice(0, 60), page_path: location.pathname });
    } else if (href.indexOf("https://wa.me/") === 0) {
      send("whatsapp_click", { page_path: location.pathname });
    } else if (href.indexOf("mailto:") === 0) {
      send("email_click", { page_path: location.pathname });
    } else if (href.indexOf("/contact-us") === 0) {
      send("quote_cta_click", { link_text: (a.textContent || "").trim().slice(0, 60), page_path: location.pathname });
    }
  });
  // Form interactions on the quote forms (which POST to /api/contact).
  var started = false;
  document.querySelectorAll('form[action="/api/contact"]').forEach(function (f) {
    f.addEventListener("input", function () {
      if (!started) { started = true; send("form_start", { page_path: location.pathname }); }
    }, { once: false });
    f.addEventListener("submit", function () {
      send("form_submit", { page_path: location.pathname });
    });
  });
  // Lead conversion: landing on /thank-you/ after a successful submission.
  if (location.pathname.indexOf("/thank-you") === 0) {
    send("generate_lead", { page_path: document.referrer ? new URL(document.referrer).pathname : "(direct)" });
  }
})();
</script>
{% endif %}

{# Trustindex floating Google-reviews widget — same setup as earnedmedia.com.au.
   Activates when trustindex_widget_id is set in _data/site.json. #}
{% if site.trustindex_widget_id %}
<script defer async src="https://cdn.trustindex.io/loader.js?{{ site.trustindex_widget_id }}"></script>
{% endif %}
</body>
</html>
