---
layout: base.njk
og_type: article
---

<article class="post">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>{{ title }}</h1>
      <p class="meta">{{ page.date | isoDate }}</p>
    </div>
  </header>

  <div class="page-body">
    <div class="wrap prose">
      {{ content | safe }}
    </div>
  </div>

  <div class="wrap">
    <p><a href="/blog/">← All posts</a></p>
  </div>
</article>
