<style>
.page-hero{ padding: clamp(48px,7vw,90px) 0 clamp(28px,4vw,56px); position:relative; overflow:hidden }
.page-hero::before{ content:""; position:absolute; right:-160px; top:-100px; width:480px; height:480px; border-radius:50%; background:var(--yellow); opacity:.5; z-index:0 }
.page-hero .wrap{ position:relative; z-index:1 }
.page-hero h1{ font-size: clamp(48px, 6vw, 100px); }
.page-hero h1 .high{ background:var(--yellow); padding:0 .1em .04em; border-radius:8px; display:inline-block; box-decoration-break:clone; -webkit-box-decoration-break:clone }

.specs{ background:var(--bg-soft) }
.specs-grid{ display:grid; grid-template-columns: repeat(4,1fr); gap: 14px }
.spec{
  background:#fff; border:1px solid var(--rule); border-radius:var(--radius);
  padding: 22px; display:flex; flex-direction:column; gap: 12px; min-height: 200px;
  position:relative;
}
.spec .num{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted) }
.spec h4{ font-size:18px; margin-top:4px }
.spec p{ color:var(--ink-2); font-size:14px }
.spec .tick{ font-family:var(--mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink); display:inline-flex; padding:4px 10px; background:var(--yellow); border-radius:999px; margin-top:auto; align-self:flex-start }
@media (max-width: 1000px){ .specs-grid{ grid-template-columns: 1fr 1fr } }
@media (max-width: 540px){ .specs-grid{ grid-template-columns: 1fr } }

.surface-grid{ display:grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px,4vw,72px); align-items:center }
.surface-img{ aspect-ratio: 1/1; border-radius: var(--radius-l); overflow:hidden; border:1px solid var(--rule) }
.surface-img img{ width:100%; height:100%; object-fit:cover }
.brand-list{ display:grid; grid-template-columns:1fr 1fr; gap:12px 24px; list-style:none; padding:0; margin:18px 0 0 }
.brand-list li{ display:flex; gap:10px; align-items:flex-start; font-size:15.5px; color:var(--ink-2) }
.brand-list li::before{
  content:""; width:18px; height:18px; flex:0 0 auto; margin-top:3px;
  background: var(--ink);
  -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5 12l4 4L19 6' stroke='black' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>") center/contain no-repeat;
          mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5 12l4 4L19 6' stroke='black' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>") center/contain no-repeat;
}
@media (max-width: 860px){ .surface-grid{ grid-template-columns: 1fr } .brand-list{ grid-template-columns: 1fr } }

.line-marking{ background:var(--ink); color:#fff; padding: var(--gap) 0 }
.line-marking h2{ color:#fff }
.lm-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: clamp(28px,4vw,72px); align-items:center }
.lm-img{ aspect-ratio: 4/3; border-radius: var(--radius-l); overflow:hidden; background: var(--bg-soft) }
.lm-img img{ width:100%; height:100%; object-fit:cover }
.lm-tags{ display:flex; flex-wrap:wrap; gap: 8px; margin-top: 20px }
.lm-tag{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; padding:6px 12px; border-radius:999px; background:rgba(255,255,255,.08); color:rgba(255,255,255,.8); border:1px solid rgba(255,255,255,.18) }
@media (max-width: 860px){ .lm-grid{ grid-template-columns: 1fr } }
</style>

